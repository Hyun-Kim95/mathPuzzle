{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathpuzzle.local/schemas/level.json",
  "title": "PuzzleLevel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "prompt",
    "input",
    "answer",
    "hint",
    "explanation",
    "difficulty"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 100 },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "number_grid",
        "shape_number",
        "operator_pattern",
        "missing_term",
        "visual_equation"
      ]
    },
    "prompt": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": ["string", "null"] },
        "layout": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["numeric", "choice"] },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "numeric" } } },
          "then": { "required": ["min", "max"] }
        },
        {
          "if": { "properties": { "mode": { "const": "choice" } } },
          "then": { "required": ["choices"] }
        }
      ]
    },
    "answer": {
      "oneOf": [{ "type": "integer" }, { "type": "string", "minLength": 1 }]
    },
    "hint": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1 },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard", "expert"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
